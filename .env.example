# ORIGIN configuration. Copy to `.env` and fill in what you need.
# Every variable has a working default for local development; none of the keys below
# is required to run demo mode or the test suite.

# --- Runtime -------------------------------------------------------------------------
# development | test | demo | production. `demo` forces ORIGIN_PROVIDER_MODE=replay.
ORIGIN_ENV=development
ORIGIN_LOG_LEVEL=INFO
# true emits JSON log lines (use in containers); false prints human-readable lines.
ORIGIN_LOG_JSON=false
# JSON list of browser origins allowed to call the API.
ORIGIN_CORS_ORIGINS=["http://localhost:3000"]

# --- Stores --------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://origin:origin@localhost:5432/origin
REDIS_URL=redis://localhost:6379/0

# s3 (MinIO locally, Cloudflare R2 deployed) | filesystem (tests, offline demo)
BLOB_BACKEND=s3
# Root directory for BLOB_BACKEND=filesystem.
BLOB_DIR=var/blobs
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=origin
S3_ACCESS_KEY=origin
S3_SECRET_KEY=origin-dev-secret

# --- Providers -----------------------------------------------------------------------
# live: call providers (responses cached) | record: live and write fixtures | replay: fixtures only
ORIGIN_PROVIDER_MODE=live
# Where recorded provider responses are read from and written to.
ORIGIN_FIXTURES_DIR=fixtures/recordings
# Unofficial engine front-end scraping (PicImageSearch). Local use only; refused in production.
ORIGIN_ENABLE_UNOFFICIAL_PROVIDERS=false
