# ORIGIN configuration. Copy to `.env` and fill in what you need.
# Every variable has a working default for local development; none of the keys below
# is required to run demo mode or the test suite.

# --- Runtime -------------------------------------------------------------------------
# development | test | demo | production. `demo` forces ORIGIN_PROVIDER_MODE=replay.
ORIGIN_ENV=development
ORIGIN_LOG_LEVEL=INFO
# true emits JSON log lines (use in containers); false prints human-readable lines.
ORIGIN_LOG_JSON=false
# JSON list of browser origins allowed to call the API.
ORIGIN_CORS_ORIGINS=["http://localhost:3000"]

# --- Stores --------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://origin:origin@127.0.0.1:5432/origin
REDIS_URL=redis://127.0.0.1:6379/0

# s3 (SeaweedFS locally, Cloudflare R2 deployed) | filesystem (tests, offline demo)
BLOB_BACKEND=s3
# Root directory for BLOB_BACKEND=filesystem.
BLOB_DIR=var/blobs
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=origin
S3_ACCESS_KEY=origin
S3_SECRET_KEY=origin-dev-secret

# --- Uploads -------------------------------------------------------------------------
# Largest accepted upload, in bytes, and largest image, in pixels (checked before decoding).
ORIGIN_UPLOAD_MAX_BYTES=20000000
ORIGIN_UPLOAD_MAX_PIXELS=50000000

# Where model weights are downloaded (gitignored; a Docker volume in compose).
ORIGIN_MODELS_DIR=models
# exiftool executable (name on PATH, or a full path).
EXIFTOOL_PATH=exiftool

# --- Providers -----------------------------------------------------------------------
# live: call providers (responses cached) | record: live and write fixtures | replay: fixtures only
ORIGIN_PROVIDER_MODE=live
# Where recorded provider responses are read from and written to.
ORIGIN_FIXTURES_DIR=fixtures/recordings
# Hand-authored responses ("synthetic": true), read after real recordings in replay mode.
ORIGIN_SYNTHETIC_FIXTURES_DIR=fixtures/synthetic
# Providers a trace queries (JSON list): vision, lens, yandex. Yandex needs a public image URL.
ORIGIN_PROVIDERS=["vision","lens"]
# Google Cloud Vision API key (restrict it to the Vision API). Free tier: 1,000 units/month.
GOOGLE_VISION_API_KEY=
# SerpApi key for Google Lens and Yandex. Free plan: 250 searches/month, 50/hour.
SERPAPI_API_KEY=
# --- Language model (claim extraction and narratives) -----------------------------------
# gemini (free tier; prompts may be used by Google to improve its products) | ollama (local) | anthropic
ORIGIN_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# On the free tier gemini-3.5-flash-lite answered in ~6 s; gemini-3.8-flash took 86-131 s.
ORIGIN_GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://127.0.0.1:11434
ORIGIN_OLLAMA_MODEL=qwen3:8b

# Unofficial engine front-end scraping (PicImageSearch). Local use only; refused in production.
ORIGIN_ENABLE_UNOFFICIAL_PROVIDERS=false
