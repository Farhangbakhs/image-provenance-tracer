        "required": [
          "id",
          "provider",
          "page_url",
          "image_url",
          "domain",
          "title",
          "match_class",
          "match_reason",
          "sscd_cosine",
          "phash_distance",
          "pdq_distance",
          "transform",
          "threshold_version",
          "date_lower",
          "date_upper",
          "date_confidence",
          "dating_rule_version",
          "deciding",
          "evidence",
          "image_url_local"
        ],
        "title": "SightingOut",
        "type": "object"
      },
      "StageState": {
        "additionalProperties": true,
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Counts",
            "type": "object"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "notes": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Notes",
            "type": "object"
          },
          "quota": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Quota",
            "type": "object"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StageState",
        "type": "object"
      },
      "UploadRejectedOut": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "message"
        ],
        "title": "UploadRejectedOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ORIGIN API",
