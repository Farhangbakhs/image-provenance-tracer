    "/cases/{case_id}/assets": {
      "post": {
        "description": "Add an image to a case: validated by content, stored, fingerprinted, and checked for\nmetadata and Content Credentials. The image is not sent to any third party here.",
        "operationId": "upload_asset_cases__case_id__assets_post",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_asset_cases__case_id__assets_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetOut"
                }
              }
            },
            "description": "Identical image already in this case"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadRejectedOut"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadRejectedOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Upload Asset",
        "tags": [
          "cases"
        ]
      }
    },
